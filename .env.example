# Frontend (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=http://localhost:5000

# Backend (Flask search API)
# csv (default): serve backend/data/catalog.csv
# supabase: read the books table, use when your database already had books with its own ids
SOMAREC_CATALOG_SOURCE=csv
SOMAREC_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Set to 1 to run keyword-only search without downloading a model
SOMAREC_DISABLE_EMBEDDINGS=0
# Required to call POST /api/admin/reindex
SOMAREC_ADMIN_TOKEN=
SOMAREC_CORS_ORIGINS=http://localhost:3000

# Scripts that write to Supabase (never use in frontend code, never commit)
SUPABASE_SERVICE_ROLE_KEY=
